{
  "name": "pi-extensions",
  "description": "A collection of independently loadable Pi extensions.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dag-cli": "./src/dag/cli.ts"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dag": "bun run src/dag/cli.ts",
    "coverage:summary": "bun run scripts/coverage-summary.ts",
    "dev": "pi --extension .",
    "fonts:import": "bun run scripts/import-snapcompact-fonts.ts",
    "lint": "biome check --error-on-warnings .",
    "fix": "biome check --write --error-on-warnings . && bun run knip:fix",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test:ci && bun run depcruise && bun run knip && bun run dupcheck",
    "danger:ci": "bun build --target=node --format=esm --packages=external --outfile=node_modules/.cache/dangerfile.js dangerfile.ts && danger ci --dangerfile node_modules/.cache/dangerfile.js",
    "prepare": "husky",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "depcruise": "depcruise --config .dependency-cruiser.ts src",
    "dupcheck": "jscpd src",
    "test": "bun test --timeout 10000 --only-failures",
    "test:ci": "bun test --timeout 10000 --only-failures --coverage",
    "test:watch": "bun test --timeout 10000 --only-failures --watch",
    "test:coverage": "bun test --timeout 10000 --only-failures --coverage"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@earendil-works/pi-coding-agent": "^1.5.1",
    "@swc/core": "^1.16.21",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "danger": "^14.1.0",
    "dependency-cruiser": "^18.7.1",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "knip": "^6.45.0",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [],
  "dependencies": {
    "@earendil-works/pi-schema": "1.5.0",
    "yaml": "^2.9.1"
  }
}
